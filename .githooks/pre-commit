#!/bin/sh
# Pre-commit gate for DonghuaPlayer.
#   1. Aborts if a staged path looks like a secret.
#   2. Aborts if a staged .dart file is not formatted.
# Only the staged content is checked, so existing unformatted files in the
# repository do not block unrelated commits.
#
# Enable once per clone: git config core.hooksPath .githooks

find_dart() {
  for candidate in \
    "${FLUTTER_ROOT:+$FLUTTER_ROOT/bin/dart.bat}" \
    "${FLUTTER_ROOT:+$FLUTTER_ROOT/bin/dart}"; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  if command -v dart >/dev/null 2>&1; then
    echo dart
    return 0
  fi
  # Default SDK location on the main development machine.
  if [ -f "D:/DevTools/flutter/bin/dart.bat" ]; then
    echo "D:/DevTools/flutter/bin/dart.bat"
    return 0
  fi
  return 1
}

# -z keeps Git from quoting non-ASCII paths, which would defeat the patterns.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')

in_secret_dir=$(printf '%s\n' "$staged" | grep -E -i '(^|/)secrets/')
secret_names=$(printf '%s\n' "$staged" |
  grep -E -i '(^|/)\.env[^/]*$|\.(pem|key|p12|pfx|jks|keystore)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)|(^|/)key\.properties$' |
  grep -E -i -v '(^|/)\.env\.example$')
secrets=$(printf '%s\n%s\n' "$in_secret_dir" "$secret_names" | sed '/^$/d')

if [ -n "$secrets" ]; then
  echo "pre-commit: refusing to commit files that look like secrets:" >&2
  echo "$secrets" | sed 's/^/  /' >&2
  exit 1
fi

if [ -z "$(git diff --cached --name-only --diff-filter=ACMR -- '*.dart')" ]; then
  exit 0
fi

dart=$(find_dart)
if [ -z "$dart" ]; then
  echo "pre-commit: Dart SDK not found. Set FLUTTER_ROOT or add dart to PATH." >&2
  exit 1
fi

# Keep the export inside the project so the formatter finds the project's
# language version and analysis options.
workdir=".dart_tool/precommit-format"
list=".dart_tool/precommit-format.list"

abort_export() {
  rm -rf "$workdir" "$list"
  echo "pre-commit: could not export staged Dart files for checking." >&2
  exit 1
}

rm -rf "$workdir" "$list"
mkdir -p "$workdir" || abort_export
git diff --cached --name-only --diff-filter=ACMR -z -- '*.dart' >"$list" ||
  abort_export
git checkout-index --stdin -z --prefix="$workdir/" <"$list" || abort_export

# A partial export must not pass as an empty, "formatted" folder.
expected=$(tr -cd '\000' <"$list" | wc -c)
exported=$(find "$workdir" -type f -name '*.dart' | wc -l)
if [ "$((expected))" -ne "$((exported))" ]; then
  abort_export
fi

output=$("$dart" format --output=none --set-exit-if-changed "$workdir" 2>&1)
status=$?
rm -rf "$workdir" "$list"

if [ "$status" -ne 0 ]; then
  echo "pre-commit: staged Dart files are not formatted (exit $status):" >&2
  echo "$output" | grep -v -E 'Package resolution error|Failed to resolve package' |
    sed -E 's#\.dart_tool[\\/]precommit-format[\\/]##' >&2
  echo "Run: dart format <file>, then stage it again." >&2
  exit 1
fi

exit 0
