{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter test *)",
      "Bash(flutter analyze *)",
      "Bash(flutter build *)",
      "Bash(dart format *)",
      "Bash(D:/DevTools/flutter/bin/flutter.bat test *)",
      "Bash(D:/DevTools/flutter/bin/flutter.bat analyze *)",
      "Bash(D:/DevTools/flutter/bin/flutter.bat build *)",
      "Bash(D:/DevTools/flutter/bin/dart.bat format *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(git commit *--am*)",
      "Bash(git add -A*)",
      "Bash(git add --a*)",
      "Bash(git add .)",
      "Bash(flutter pub *)",
      "Bash(dart pub *)",
      "Bash(D:/DevTools/flutter/bin/flutter.bat pub *)",
      "Bash(D:/DevTools/flutter/bin/dart.bat pub *)",
      "Bash(npm install *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(git commit *--am*)"
    ],
    "deny": [
      "Bash(git commit *--no-ve*)",
      "Bash(git commit -n*)",
      "Bash(git commit -an*)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -an *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -an)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "PowerShell(git commit *--no-ve*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit -an*)",
      "PowerShell(git commit * -n *)",
      "PowerShell(git commit * -an *)",
      "PowerShell(git commit * -n)",
      "PowerShell(git commit * -an)",
      "PowerShell(git diff *--no-index*)",
      "PowerShell(git diff *--output*)",
      "PowerShell(git log *--output*)",
      "PowerShell(git show *--output*)",
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/id_dsa*)",
      "Read(./**/id_ecdsa*)",
      "Read(./android/key.properties)",
      "Read(./**/secrets/**)",
      "Edit(./**/.env*)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./**/*.p12)",
      "Edit(./**/*.pfx)",
      "Edit(./**/*.jks)",
      "Edit(./**/*.keystore)",
      "Edit(./android/key.properties)",
      "Edit(./**/secrets/**)"
    ]
  }
}
