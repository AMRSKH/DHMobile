<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later always show a system splash with the app icon.
         It cannot be turned off, so it is made invisible: a black background
         and a transparent icon. NormalTheme comes from values/styles.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_no_icon</item>
    </style>
</resources>
